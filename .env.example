# Database Configuration (PostgreSQL)
# Un-comment and fill in these variables inside a new file named `.env` in the root folder

DB_NAME=flowforce_db
DB_USER=flowforce_user
DB_PASSWORD=YOUR_REAL_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# Other Configuration
DEBUG=False
SECRET_KEY=your_django_secret_key
ALLOWED_HOSTS=your_domain.com,your_vps_ip

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=operations.flowforce@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password_here
DEFAULT_FROM_EMAIL=Flow-Force Workspace <operations.flowforce@gmail.com>

# Session Configuration (Optional, defaults to 10 years)
# SESSION_COOKIE_AGE=315360000

# Cache Configuration (Redis for shared production caching; defaults to LocMemCache if omitted)
# Celery uses DB 0; Django cache uses DB 1
CACHE_URL=redis://127.0.0.1:6379/1
