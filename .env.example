# Database Configuration (PostgreSQL)
# Un-comment and fill in these variables inside a new file named `.env` in the root folder

DB_NAME=flowforce_db
DB_USER=flowforce_user
DB_PASSWORD=YOUR_REAL_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# Other Configuration
DEBUG=False
SECRET_KEY=your_django_secret_key
ALLOWED_HOSTS=your_domain.com,your_vps_ip

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Use the SMTP server of the flowforceworkspace.cloud mailbox (or a Gmail account that has
# noreply@flowforceworkspace.cloud added and verified under "Send mail as").
EMAIL_HOST=smtp.your-mail-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@flowforceworkspace.cloud
EMAIL_HOST_PASSWORD=your_smtp_password_here
DEFAULT_FROM_EMAIL=Flow-Force Workspace <noreply@flowforceworkspace.cloud>

# Session Configuration (Optional, defaults to 10 years)
# SESSION_COOKIE_AGE=315360000

# Cache Configuration (Redis for shared production caching; defaults to LocMemCache if omitted)
# Celery uses DB 0; Django cache uses DB 1; Channels uses DB 2
CACHE_URL=redis://127.0.0.1:6379/1

# Channels / WebSocket Configuration (Redis DB 2 for real-time channel layer)
CHANNELS_REDIS_URL=redis://127.0.0.1:6379/2

# Device Authorization & Hardware Restriction System
# Operational mode: ENFORCE (default) | LOG_ONLY (Soft mode for rollout) | DISABLED
DEVICE_RESTRICTION_MODE=ENFORCE
# Optional emergency bypass token for developer/admin emergency API bypass
# DEVICE_BYPASS_TOKEN=super_secret_bypass_token_here

# Google Gemini & AI Usage Tracker
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Prices per 1,000,000 tokens in USD from Google's current pricing page for GEMINI_MODEL
GEMINI_PRICE_INPUT_PER_M=0.075
GEMINI_PRICE_OUTPUT_PER_M=0.30
AI_USD_TO_IDR=16000
AI_MONTHLY_BUDGET_USD=0
AI_BLOCK_OVER_BUDGET=False

# Synology NAS & Tickets Storage
SYNOLOGY_URL=http://tailscale-nas-ip-or-name:5000
SYNOLOGY_USER=workspace-bot
SYNOLOGY_PASSWORD=
SYNOLOGY_ROOT=/FF-Jobs
SYNOLOGY_VERIFY_SSL=True
TICKETS_MAX_UPLOAD_MB=5120
TICKETS_NAS_SCAN_MINUTES=15
